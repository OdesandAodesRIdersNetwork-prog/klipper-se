[Unit]
Description=Klipper-SE 3D Printer Firmware
Documentation=https://www.klipper3d.org/
After=network-online.target
Wants=udev.target

[Service]
Type=simple
User=@USER@
RemainAfterExit=yes
WorkingDirectory=@HOME@/klipper-port
EnvironmentFile=@PRINTER_DATA@/systemd/klipper.env
ExecStart=@HOME@/klippy-env/bin/python $KLIPPER_ARGS
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
